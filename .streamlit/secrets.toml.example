# Copy to secrets.toml and fill in values (secrets.toml is gitignored).
# On Railway / Docker: set the same variable names as environment variables instead.
# Primary OpenRouter key for anthropic/claude-sonnet-4 (required).
CLAUDE_SONNET_4_API_KEY = ""
# Optional fallbacks — used immediately if the previous key fails (then wrap to #1).
CLAUDE_SONNET_4_API_KEY_2 = ""
CLAUDE_SONNET_4_API_KEY_3 = ""

# Optional — Azure blob archiving
AZURE_STORAGE_CONNECTION_STRING = ""
AZURE_BLOB_CONTAINER = "resume-archive"

# Azure Cosmos DB — candidate fields + Global Search (free tier friendly)
COSMOS_ENDPOINT = ""
COSMOS_KEY = ""
COSMOS_DATABASE = "resume-db"
COSMOS_CONTAINER = "candidates"
